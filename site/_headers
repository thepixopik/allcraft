# Unified Cloudflare Pages _headers for The AllCraft Studio (15-App Suite)

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# Entry HTML & manifest files: revalidate on every visit so updates appear immediately
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/build-manifest.json
  Cache-Control: no-cache

/vector/
  Cache-Control: no-cache

/vector/index.html
  Cache-Control: no-cache

/photo/
  Cache-Control: no-cache

/photo/index.html
  Cache-Control: no-cache

/light/
  Cache-Control: no-cache

/light/index.html
  Cache-Control: no-cache

/light/lightcraft_web.js
  Cache-Control: no-cache

/light/worker.js
  Cache-Control: no-cache

/design/
  Cache-Control: no-cache

/design/index.html
  Cache-Control: no-cache

/ani/
  Cache-Control: no-cache

/ani/index.html
  Cache-Control: no-cache

/ani/anicraft.js
  Cache-Control: no-cache

/texture/
  Cache-Control: no-cache

/texture/index.html
  Cache-Control: no-cache

/material/
  Cache-Control: no-cache

/material/index.html
  Cache-Control: no-cache

/word/
  Cache-Control: no-cache

/word/index.html
  Cache-Control: no-cache

/grid/
  Cache-Control: no-cache

/grid/index.html
  Cache-Control: no-cache

/deck/
  Cache-Control: no-cache

/deck/index.html
  Cache-Control: no-cache

/pdf/
  Cache-Control: no-cache
  Cross-Origin-Opener-Policy: same-origin

/pdf/index.html
  Cache-Control: no-cache
  Cross-Origin-Opener-Policy: same-origin

/pdf/models/*
  Cache-Control: no-cache

/film/
  Cache-Control: no-cache

/film/index.html
  Cache-Control: no-cache

/effect/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

/effect/
  Cache-Control: no-cache
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

/effect/index.html
  Cache-Control: no-cache
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

/effect/sw.js
  Cache-Control: no-cache

/effect/effectcraft_web.js
  Cache-Control: no-cache

/effect/worker.js
  Cache-Control: no-cache

/sound/
  Cache-Control: no-cache

/sound/index.html
  Cache-Control: no-cache

/cad/
  Cache-Control: no-cache

/cad/index.html
  Cache-Control: no-cache

/:app/
  Cache-Control: no-cache

/:app/index.html
  Cache-Control: no-cache

# Hashed/chunked Wasm & JS assets across all Studio apps: cache for 1 year
/vector/*.part*
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=31536000, immutable

