# Unified Cloudflare Pages _headers for AllCraft Studio (allcraft.app)

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Keep internal Wasm runtime mounts out of search engine indexes (100% SEO goes to /<slug>/)
/runtime/*
  X-Robots-Tag: noindex, nofollow

# Entry HTML, SEO & manifest files: revalidate on every visit so updates appear immediately
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: no-cache

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache

/adobe-alternative/
  Cache-Control: no-cache

/artcraft-web/
  Cache-Control: no-cache

/hover-preload.js
  Cache-Control: no-cache

/prefetch-manifest.json
  Cache-Control: no-cache

/build-manifest.json
  Cache-Control: no-cache

# Cross-Origin Isolation on PDF & Effect detail/launch pages so embedded runtimes get SharedArrayBuffer
/pdfcraft
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

/pdfcraft/
  Cache-Control: no-cache
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

/pdfcraft/index.html
  Cache-Control: no-cache
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

/effectcraft
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

/effectcraft/
  Cache-Control: no-cache
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

/effectcraft/index.html
  Cache-Control: no-cache
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: credentialless

/:slug/
  Cache-Control: no-cache

/:slug/index.html
  Cache-Control: no-cache

# Runtime HTML & non-hashed worker/glue scripts: revalidate on every deploy
/runtime/:slug/
  Cache-Control: no-cache

/runtime/:slug/index.html
  Cache-Control: no-cache

/runtime/lightcraft/lightcraft_web.js
  Cache-Control: no-cache

/runtime/lightcraft/worker.js
  Cache-Control: no-cache

/runtime/anicraft/anicraft.js
  Cache-Control: no-cache

/runtime/pdfcraft/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin

/runtime/pdfcraft/
  Cache-Control: no-cache
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin

/runtime/pdfcraft/index.html
  Cache-Control: no-cache
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin

/runtime/pdfcraft/models/*
  Cache-Control: no-cache

/runtime/effectcraft/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin

/runtime/effectcraft/
  Cache-Control: no-cache
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin

/runtime/effectcraft/index.html
  Cache-Control: no-cache
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Resource-Policy: same-origin

/runtime/effectcraft/sw.js
  Cache-Control: no-cache

/runtime/effectcraft/effectcraft_web.js
  Cache-Control: no-cache

/runtime/effectcraft/worker.js
  Cache-Control: no-cache

# Hashed/chunked Wasm & JS assets across all 15 Studio runtimes: cache for 1 year
/runtime/:slug/*.part*
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=31536000, immutable

/runtime/:slug/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable
