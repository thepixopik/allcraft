# Unified Cloudflare Pages _headers for The AllCraft Studio (/, /vector/*, /photo/*, and future /* apps)

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# Entry HTML & manifest files: revalidate on every visit so updates appear immediately
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/build-manifest.json
  Cache-Control: no-cache

/*/
  Cache-Control: no-cache

/*/index.html
  Cache-Control: no-cache

# Unhashed app boot loaders & chunk manifests must always revalidate
/*/app/photocraft-web.js
  Cache-Control: no-cache

/*/app/parts.txt
  Cache-Control: no-cache

# Hashed/chunked Wasm & JS assets across all current and future Studio apps: cache for 1 year
/*/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable

/*/*.part*
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=31536000, immutable

/*/app/*.part-*
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=31536000, immutable
