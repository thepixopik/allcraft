# Unified Cloudflare Pages _headers for The AllCraft Studio (/, /vector/*, /photo/*, /film/*, and future /:app/* apps)

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# Entry HTML & manifest files: revalidate on every visit so updates appear immediately
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/build-manifest.json
  Cache-Control: no-cache

/vector/
  Cache-Control: no-cache

/vector/index.html
  Cache-Control: no-cache

/photo/
  Cache-Control: no-cache

/photo/index.html
  Cache-Control: no-cache

/film/
  Cache-Control: no-cache

/film/index.html
  Cache-Control: no-cache

/:app/
  Cache-Control: no-cache

/:app/index.html
  Cache-Control: no-cache

# Hashed/chunked Wasm & JS assets across Vector, Photo, Film, and all future Studio apps: cache for 1 year
/vector/*.part*
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=31536000, immutable

/photo/*.part*
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=31536000, immutable

/film/*.part*
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=31536000, immutable

/:app/*.part*
  Content-Type: application/octet-stream
  Cache-Control: public, max-age=31536000, immutable

/:app/*.wasm
  Content-Type: application/wasm
  Cache-Control: public, max-age=31536000, immutable
